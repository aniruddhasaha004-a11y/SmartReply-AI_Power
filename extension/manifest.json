{
  "manifest_version": 3,
  "name": "SmartReply - AI Email Auto-Responder",
  "version": "1.0",
  "description": "Generate context-aware email replies in Gmail using Gemini AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://smartreply-ai-power.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
